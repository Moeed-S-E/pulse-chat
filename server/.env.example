# PulseChat Server Environment Variables

# Server Port (Render sets this automatically)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas URI recommended for Render)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pulsechat?retryWrites=true&w=majority

# JWT Token Secret Key
JWT_SECRET=pulsechat_production_jwt_secret_key_change_me

# Allowed Frontend Client URL(s) for CORS (supports single URL or comma-separated list)
CLIENT_URL=https://your-pulsechat-frontend.vercel.app
